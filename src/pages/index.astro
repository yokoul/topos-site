---
/**
 * Racine du site : envoie vers la langue du navigateur (fr, zh), sinon vers l'anglais.
 * Repli sans JavaScript : meta refresh vers /en/ et liens explicites.
 */
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<meta http-equiv="refresh" content="1; url=/en/" />
		<title>topos</title>
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<script is:inline>
			(function () {
				var langs = (navigator.languages || [navigator.language || 'en']).map(function (l) {
					return l.toLowerCase().slice(0, 2);
				});
				var target = 'en';
				for (var i = 0; i < langs.length; i++) {
					if (langs[i] === 'fr' || langs[i] === 'zh') { target = langs[i]; break; }
					if (langs[i] === 'en') break;
				}
				location.replace('/' + target + '/');
			})();
		</script>
		<style>
			body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #f6f7f4; color: #1b2a2f; font-family: 'Atkinson Hyperlegible', system-ui, sans-serif; }
			nav { display: flex; gap: 1.5rem; font-size: 1rem; }
			a { color: #1b2a2f; }
			.brand { font-weight: 800; font-size: 2rem; letter-spacing: -0.03em; margin-bottom: 1rem; text-align: center; }
			.brand i { font-style: normal; color: #e1332b; }
		</style>
	</head>
	<body>
		<div>
			<div class="brand">topos<i>.</i></div>
			<nav>
				<a href="/en/">English</a>
				<a href="/fr/">Français</a>
				<a href="/zh/">中文</a>
			</nav>
		</div>
	</body>
</html>
