---
/**
 * Le schéma de trilatération — héros de l'accueil.
 * Quatre ancres, trois cercles de distance, un point tracké. Libellés plateau selon la langue.
 */
interface Props {
	lang?: string;
}
const { lang = 'en' } = Astro.props;
const L =
	{
		en: { up: 'UPSTAGE', down: 'DOWNSTAGE', left: 'STAGE LEFT', right: 'STAGE RIGHT', alt: 'Stage plan: four anchors, three distance circles, one tracked point' },
		fr: { up: 'LOINTAIN', down: 'FACE', left: 'JARDIN', right: 'COUR', alt: 'Plan de scène : quatre ancres, trois cercles de distance, un point tracké' },
		'zh-CN': { up: '舞台后方', down: '舞台前方', left: '舞台左侧', right: '舞台右侧', alt: '舞台平面图：四个基站，三个距离圆，一个被跟踪的点' },
	}[lang] ?? { up: 'UPSTAGE', down: 'DOWNSTAGE', left: 'STAGE LEFT', right: 'STAGE RIGHT', alt: 'Stage plan' };
---

<svg viewBox="0 0 600 360" role="img" aria-label={L.alt} class="tp-plan">
	<rect x="60" y="40" width="480" height="280" fill="none" stroke="#1B2A2F" stroke-width="1.5" />
	<g font-family="Atkinson Hyperlegible, sans-serif" font-size="11" letter-spacing="2" fill="#8A969A" text-anchor="middle">
		<text x="300" y="30">{L.up}</text>
		<text x="300" y="342">{L.down}</text>
		<text x="44" y="184" transform="rotate(-90 44 184)">{L.left}</text>
		<text x="556" y="184" transform="rotate(90 556 184)">{L.right}</text>
	</g>
	<g fill="none" stroke="#1B2A2F" stroke-width="0.8" stroke-dasharray="4 4" opacity="0.42">
		<circle cx="80" cy="60" r="295" /><circle cx="520" cy="60" r="228" /><circle cx="80" cy="300" r="279" />
	</g>
	<g fill="#1B2A2F">
		<rect x="74" y="54" width="12" height="12" /><rect x="514" y="54" width="12" height="12" />
		<rect x="74" y="294" width="12" height="12" /><rect x="514" y="294" width="12" height="12" />
	</g>
	<g font-family="Atkinson Hyperlegible, sans-serif" font-size="11" fill="#4F5E63">
		<text x="92" y="64">A0</text><text x="492" y="64">A1</text><text x="92" y="304">A2</text><text x="492" y="304">A3</text>
	</g>
	<g stroke="#E1332B" stroke-width="0.8" opacity="0.5">
		<line x1="80" y1="60" x2="340" y2="200" /><line x1="520" y1="60" x2="340" y2="200" /><line x1="80" y1="300" x2="340" y2="200" />
	</g>
	<circle cx="340" cy="200" r="14" fill="#E1332B" opacity="0.15" class="tp-pulse" />
	<circle cx="340" cy="200" r="5.5" fill="#E1332B" />
	<text x="354" y="196" font-family="Atkinson Hyperlegible, sans-serif" font-size="12" font-weight="700" fill="#1B2A2F">Alice</text>
	<text x="354" y="211" font-family="Atkinson Hyperlegible, sans-serif" font-size="11" fill="#4F5E63">x 1.23 m · z −0.40 m</text>
	<text x="200" y="138" font-family="Atkinson Hyperlegible, sans-serif" font-size="10" fill="#E1332B" transform="rotate(28 200 138)">2.95 m</text>
	<line x1="300" y1="176" x2="300" y2="184" stroke="#1B2A2F" stroke-width="1" /><line x1="296" y1="180" x2="304" y2="180" stroke="#1B2A2F" stroke-width="1" />
	<text x="306" y="178" font-family="Atkinson Hyperlegible, sans-serif" font-size="9" fill="#8A969A">0,0</text>
</svg>

<style>
	.tp-plan {
		width: 100%;
		height: auto;
		display: block;
	}
	@media (prefers-reduced-motion: no-preference) {
		.tp-pulse {
			transform-origin: 340px 200px;
			animation: tp-pulse 2.4s ease-in-out infinite;
		}
		@keyframes tp-pulse {
			0%, 100% { transform: scale(1); opacity: 0.15; }
			50% { transform: scale(1.6); opacity: 0.05; }
		}
	}
</style>
