---
/**
 * Hero topos.red : titre, accroche, actions, pastille d'état, et le schéma de trilatération.
 * Remplace le Hero Starlight (qui n'accepte qu'une image statique).
 */
import { LinkButton } from '@astrojs/starlight/components';
const PAGE_TITLE_ID = '_top';
import Plan from './Plan.astro';

const { entry, lang } = Astro.locals.starlightRoute;
const { data } = entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const state = (data as { state?: string }).state;
---

<div class="hero">
	<div class="hero-html sl-flex"><Plan {lang} /></div>
	<div class="sl-flex stack">
		<div class="sl-flex copy">
			<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
			{tagline && <div class="tagline" set:html={tagline} />}
		</div>
		{
			actions.length > 0 && (
				<div class="sl-flex actions">
					{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
						<LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
							{text}
						</LinkButton>
					))}
				</div>
			)
		}
		{state && <div class="tp-state">{state}</div>}
	</div>
</div>

<style>
	@layer starlight.core {
		.hero {
			display: grid;
			grid-template-columns: 100%;
			align-items: center;
			gap: 1.5rem;
			padding-bottom: 1rem;
		}
		.hero > .hero-html {
			width: 100%;
		}
		.stack {
			flex-direction: column;
			gap: clamp(1.25rem, calc(1rem + 1vw), 1.75rem);
			text-align: start;
		}
		.copy {
			flex-direction: column;
			gap: 1rem;
			align-items: flex-start;
		}
		.copy > * {
			max-width: 50ch;
		}
		.actions {
			gap: 0.75rem 1rem;
			flex-wrap: wrap;
		}
		@media (min-width: 50rem) {
			.hero {
				grid-template-columns: 11fr 9fr;
				gap: 4%;
				padding-block: clamp(2rem, calc(1rem + 6vmin), 5rem);
			}
			.hero > .hero-html {
				order: 2;
			}
		}
	}
</style>
