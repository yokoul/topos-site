<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  topos.red — site statique servi par Caddy depuis ~/apps/topos-site/dist.
  Ce daemon n'est pas un serveur : il lance ops/deploy.sh au boot puis toutes
  les 5 minutes (pull + build si origin/main a bougé). « Redeploy » depuis
  dash.yokoul.xyz = kickstart -k de ce label.

  Installation :
    sudo install -m 644 -o root -g wheel ~/apps/topos-site/ops/ch.oul.topos-site.plist /Library/LaunchDaemons/
    sudo launchctl bootstrap system /Library/LaunchDaemons/ch.oul.topos-site.plist
    sudo launchctl enable system/ch.oul.topos-site
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ch.oul.topos-site</string>

    <key>UserName</key>
    <string>may</string>
    <key>GroupName</key>
    <string>staff</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/may/apps/topos-site/ops/deploy.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/may/apps/topos-site</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/may</string>
        <key>PATH</key>
        <string>/Users/may/.local/share/fnm/aliases/default/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>/Users/may/Library/Logs/apps/topos-site.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/may/Library/Logs/apps/topos-site.err.log</string>
</dict>
</plist>
